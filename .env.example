# ===================================================
# HKAYA Kids Library — Backend Environment Configuration
# ===================================================
# Copy this file to `server/.env` and fill in your real credentials.
# NEVER commit the actual `.env` file to version control.

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Path to SQLite file or connection URL)
DATABASE_PATH=server/data/hkaya.db

# Authentication
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Provisioned on first database migration if no admin exists)
ADMIN_INITIAL_EMAIL=admin@hkayalibrary.co.ke
ADMIN_INITIAL_PASSWORD=HkayaAdmin2026!Secure

# ===================================================
# Safaricom Daraja M-Pesa Credentials
# ===================================================
# Environment: 'sandbox' for Safaricom Daraja test portal, 'production' for live store
MPESA_ENVIRONMENT=sandbox

# Daraja Developer Portal App Consumer Key & Secret
MPESA_CONSUMER_KEY=your_daraja_app_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_app_consumer_secret

# Business Shortcode (Paybill or Till Number, e.g. 174379 for Daraja Sandbox)
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online Passkey (from Daraja portal)
MPESA_PASSKEY=bfb279f9aa9bdbaca158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c91

# Public HTTPS Callback URL where Safaricom sends payment results
# In production: https://api.hkayalibrary.co.ke/api/payments/mpesa/callback
# In local development: use ngrok or similar tunnel, e.g. https://your-tunnel.ngrok-free.app/api/payments/mpesa/callback
MPESA_CALLBACK_URL=https://api.hkayalibrary.co.ke/api/payments/mpesa/callback

# Transaction Type: 'CustomerPayBillOnline' or 'CustomerBuyGoodsOnline'
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
